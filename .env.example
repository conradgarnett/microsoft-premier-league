# Copy to .env. Everything is optional: with no model settings the agents run on the
# deterministic offline provider and the whole app works without any cloud access.

# --- Azure OpenAI / Microsoft Foundry model deployment (enables LLM agents) ---
AZURE_OPENAI_ENDPOINT=            # e.g. https://<resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=          # e.g. gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=             # or leave empty and set AZURE_OPENAI_USE_ENTRA=1 (managed identity / az login)
AZURE_OPENAI_USE_ENTRA=0

# --- Storage ---
STORE=local                       # local | cosmos
DATA_DIR=data/matches
COSMOS_ENDPOINT=                  # https://<account>.documents.azure.com:443/
COSMOS_KEY=                       # or leave empty to use Entra ID (DefaultAzureCredential)
COSMOS_DATABASE=tactical
COSMOS_CONTAINER=matches

# --- App ---
AUTOGENERATE=1                    # generate a match on first start if the store is empty
DEFAULT_SEED=7
DEFAULT_MINUTES=90
CORS_ORIGINS=*
